{
  "name": "@metreeca/http",
  "version": "0.3.0",
  "description": "Composable middleware for the standard fetch API.",
  "keywords": [
    "typescript",
    "http",
    "fetch",
    "middleware"
  ],
  "homepage": "https://metreeca.github.io/http/",
  "bugs": {
    "url": "https://github.com/metreeca/http/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/http.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./basic": "./dist/authenticators/basic.js",
    "./bearer": "./dist/authenticators/bearer.js",
    "./headers": "./dist/controllers/headers.js",
    "./throttle": "./dist/controllers/throttle.js",
    "./timeout": "./dist/controllers/timeout.js",
    "./success": "./dist/controllers/success.js",
    "./monitor": "./dist/controllers/monitor.js",
    "./xsrf": "./dist/controllers/xsrf.js",
    "./cache": "./dist/resolvers/cache/index.js",
    "./protocol": "./dist/resolvers/protocol.js",
    "./transport": "./dist/resolvers/transport.js",
    "./mock": "./dist/resolvers/mock.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && sh package.sh",
    "build": "rm -rf dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
