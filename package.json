{
  "name": "@metreeca/http",
  "version": "0.4.0",
  "description": "Composable middleware for the standard fetch API.",
  "keywords": [
    "typescript",
    "http",
    "fetch",
    "middleware"
  ],
  "homepage": "https://metreeca.github.io/http/",
  "bugs": {
    "url": "https://github.com/metreeca/http/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/http.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./basic": {
      "@metreeca/source": "./src/authenticators/basic.ts",
      "default": "./dist/authenticators/basic.js"
    },
    "./bearer": {
      "@metreeca/source": "./src/authenticators/bearer.ts",
      "default": "./dist/authenticators/bearer.js"
    },
    "./headers": {
      "@metreeca/source": "./src/controllers/headers.ts",
      "default": "./dist/controllers/headers.js"
    },
    "./throttle": {
      "@metreeca/source": "./src/controllers/throttle.ts",
      "default": "./dist/controllers/throttle.js"
    },
    "./timeout": {
      "@metreeca/source": "./src/controllers/timeout.ts",
      "default": "./dist/controllers/timeout.js"
    },
    "./success": {
      "@metreeca/source": "./src/controllers/success.ts",
      "default": "./dist/controllers/success.js"
    },
    "./monitor": {
      "@metreeca/source": "./src/controllers/monitor.ts",
      "default": "./dist/controllers/monitor.js"
    },
    "./xsrf": {
      "@metreeca/source": "./src/controllers/xsrf.ts",
      "default": "./dist/controllers/xsrf.js"
    },
    "./cache": {
      "@metreeca/source": "./src/resolvers/cache/index.ts",
      "default": "./dist/resolvers/cache/index.js"
    },
    "./protocol": {
      "@metreeca/source": "./src/resolvers/protocol.ts",
      "default": "./dist/resolvers/protocol.js"
    },
    "./transport": {
      "@metreeca/source": "./src/resolvers/transport.ts",
      "default": "./dist/resolvers/transport.js"
    },
    "./mock": {
      "@metreeca/source": "./src/resolvers/mock.ts",
      "default": "./dist/resolvers/mock.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ln",
    "build": "rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.12.1"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.4.0",
    "@types/node": "^26.1.1",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
